# Server
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# Public base URL of this service (your tunnel URL in development).
# Used when registering webhooks and as the link target in Slack/email notifications.
PUBLIC_BASE_URL=

# Database (SQLite for MVP)
DATABASE_URL="file:./dev.db"

# --- Shopify ---
# Your store's myshopify domain, e.g. my-store.myshopify.com
SHOPIFY_SHOP_DOMAIN=
# Custom app Admin API access token (shpat_...)
SHOPIFY_ADMIN_TOKEN=
# Webhook signing secret (shown once when you create the custom app)
SHOPIFY_WEBHOOK_SECRET=
# Admin API version
SHOPIFY_API_VERSION=2025-01

# --- WhatsApp Cloud API (Meta) ---
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_TEMPLATE_NAME=order_confirmation_v1
WHATSAPP_TEMPLATE_LANGUAGE=en

# --- Gemini ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Inbox basic auth ---
INBOX_USERNAME=
INBOX_PASSWORD=

# --- Optional: outbound notification hooks (leave blank to disable) ---
SLACK_WEBHOOK_URL=
